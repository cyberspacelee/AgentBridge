# Loaded from the working directory (normally code/). Process environment wins.
AGENT_ENGINE=pi
AGENT_HOST=127.0.0.1
AGENT_PORT=3000

# Optional OpenAI-compatible provider, shared by both engines.
# AGENT_OPENAI_BASE_URL=https://api.example.com/v1
# AGENT_OPENAI_PROVIDER=compatible
# AGENT_OPENAI_MODELS=model-id,another-model
# AGENT_OPENAI_API_KEY=your-key
# AGENT_OPENAI_API=openai-completions
# AGENT_MODEL={"providerID":"compatible","modelID":"model-id"}

# Optional native configuration; use absolute paths.
# ENGINE_A_PORT=4097
# ENGINE_B_CONFIG_DIR=/home/your-user/.pi/agent
# OPENCODE_CONFIG=/home/your-user/.config/opencode/opencode.json
