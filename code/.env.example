# pnpm start/dev load this before starting the application Node process.
# Read from code/; process environment wins.
AGENT_ENGINE=pi
AGENT_HOST=127.0.0.1
AGENT_PORT=3000

# Optional enterprise network settings. Restart the gateway after changes.
# These do not read the operating system's proxy settings or PAC files.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,::1
# NODE_USE_ENV_PROXY=1
# NODE_USE_SYSTEM_CA=1
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
# Dependency installation needs these variables in the shell/service environment;
# pnpm install does not load this application .env file.

# Optional first-run bootstrap. Once settings.json exists, it is authoritative.
# Configure shared connections and per-agent references at /agents.
# AGENT_OPENAI_BASE_URL=https://api.example.com/v1
# AGENT_OPENAI_PROVIDER=compatible
# AGENT_OPENAI_MODELS=model-id,another-model
# AGENT_OPENAI_API_KEY=your-key
# AGENT_OPENAI_API=openai-completions
# AGENT_MODEL={"providerID":"compatible","modelID":"model-id"}

# Optional first-run external source instead of the default managed installation.
# AGENT_MANAGED_RUNTIMES=false
# CLI executable overrides only initialize external sources. Native configurations are generated in AGENT_DATA_DIR.
# CODEX_COMMAND=codex
# GROK_COMMAND=grok
# ENGINE_A_PORT=4097
