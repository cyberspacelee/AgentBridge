{
  "name": "agentbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "node tools/start.mjs --import tsx --watch src/main.ts",
    "start": "node tools/start.mjs dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "pnpm exec playwright test",
    "web:dev": "pnpm --filter @agentbridge/web dev",
    "web:build": "pnpm --filter @agentbridge/web build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/static": "10.1.3",
    "cross-spawn": "7.0.6",
    "eventsource-parser": "4.1.0",
    "fastify": "5.12.3",
    "opencode-ai": "1.18.29",
    "pi-mcp-adapter": "2.32.1",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "prom-client": "15.1.3",
    "smol-toml": "^1.8.0",
    "typebox": "1.3.27",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.13.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
